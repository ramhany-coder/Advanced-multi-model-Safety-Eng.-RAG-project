GPT_API = ""
GEMINI_API = ""
GEMINI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
GROQ_API = ""
GROQ_BASE_URL = "https://api.groq.com"
OLLAMA_PATH = "http://localhost:11434"
PARENT_PATH = ""

EMBEDDING_MODEL_NAME = "sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_MODEL_PATH = "models/embedding"
EMBEDDINGS_CACHE_DIR = "cache/osha_chroma"
ENABLE_CACHE_REASONING = True

WHISPER_MODEL_SIZE = "small"
WHISPER_MODEL_PATH = "models/whisper"

PII_TRANSFORMER_MODEL_NAME = "Davlan/xlm-roberta-base-ner-hrl"
PII_TRANSFORMER_MODEL_PATH = "models/pii_transformer"

# Defaults below reproduce full accuracy everywhere. On a memory-constrained
# host (e.g. Streamlit Community Cloud free tier, ~1GB RAM), override via that
# platform's own secrets/env, not here, so other deployments are unaffected:
#   WARM_UP_PII_ON_STARTUP = False
#   ENABLE_MULTILINGUAL_PII = False
#   PII_SPACY_MODEL_NAME = "en_core_web_sm"
WARM_UP_PII_ON_STARTUP = True
ENABLE_MULTILINGUAL_PII = True
PII_SPACY_MODEL_NAME = "en_core_web_lg"
